# demo: API calls are disabled. live: real OpenAI + selected TTS.
APP_MODE=demo
PORT=3000
OPENAI_API_KEY=
# Kept from the existing project; change to a model available to your API project.
OPENAI_MODEL=gpt-5.6-luna
TTS_ENABLED=true
TTS_PROVIDER=naver
NAVER_TTS_CLIENT_ID=
NAVER_TTS_CLIENT_SECRET=
NAVER_TTS_SPEAKER=nara
# Optional alternative: TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
IDLE_SECONDS=45
USER_COOLDOWN_SECONDS=4
# Counts attempted AI turns (including failures), per UTC day, not a currency budget.
DAILY_TURN_LIMIT=200

# Official CHZZK developer application. Enable chat, donation, subscription read scopes.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=http://localhost:3000/auth/chzzk/callback
CHZZK_CHANNEL_ID=e76d5740ed3e21bcbd2daaff045ce955

VTS_URL=ws://127.0.0.1:8001
# Use IDs or exact names from YOUR loaded model. Prefer non-toggle expression hotkeys.
VTS_HOTKEYS={}
